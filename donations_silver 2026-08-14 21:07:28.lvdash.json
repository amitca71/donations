{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "donations_silver",
      "config": {
        "version": "1.1",
        "source": "amit.default.donations_silver",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all"
          }
        ]
      }
    },
    {
      "name": "repeat_donors",
      "displayName": "Repeat Donors",
      "queryLines": [
        "SELECT\n",
        "  prisoner,\n",
        "  donor_name,\n",
        "  COUNT(*) as times_donated,\n",
        "  SUM(amount_ils) as total_amount\n",
        "FROM\n",
        "  amit.default.donations_silver\n",
        "GROUP BY\n",
        "  prisoner,\n",
        "  donor_name\n",
        "HAVING\n",
        "  COUNT(*) > 1\n",
        "ORDER BY\n",
        "  times_donated DESC"
      ]
    }
  ],
